%% C4 container-level runtime view.
%% Audience: recruiters and technical reviewers tracing a production request.
flowchart LR
  visitor(["Portfolio visitor"]):::actor

  subgraph publicWeb["PUBLIC WEB"]
    pages["GitHub Pages<br/>React + TypeScript SPA"]:::surface
  end

  subgraph azure["AZURE RESOURCE GROUP · KOREA CENTRAL"]
    functions["Azure Functions · Python 3.11<br/>/health · /GetVisitorCount<br/>/AiChatAssistant"]:::runtime
    cosmos[("Cosmos DB for NoSQL<br/>PortfolioDB<br/>Counter · VisitorIPs")]:::state
    insights["Application Insights<br/>requests · failures · exceptions"]:::observe
    logs[("Log Analytics<br/>30-day retention · 0.1 GB/day cap")]:::observe
  end

  provider["OpenCode Zen<br/>AI provider API"]:::external

  visitor -->|"HTTPS"| pages
  pages -->|"CORS HTTPS · JSON"| functions
  functions -->|"read / conditional write"| cosmos
  functions -->|"chat completions"| provider
  functions -.->|"runtime telemetry"| insights
  insights -->|"workspace telemetry"| logs

  classDef actor fill:#eee9de,stroke:#e0522d,color:#171912,stroke-width:2px
  classDef surface fill:#eee9de,stroke:#171912,color:#171912,stroke-width:1.5px
  classDef runtime fill:#171912,stroke:#e0522d,color:#f3eee3,stroke-width:2px
  classDef state fill:#ded8ca,stroke:#275d57,color:#171912,stroke-width:1.5px
  classDef observe fill:#d2ded8,stroke:#275d57,color:#171912,stroke-width:1.5px
  classDef external fill:#eee9de,stroke:#766f62,color:#171912,stroke-dasharray:5 4
  style publicWeb fill:transparent,stroke:#766f62,stroke-width:1px
  style azure fill:transparent,stroke:#e0522d,stroke-width:1px
  linkStyle default stroke:#766f62,stroke-width:1.5px,color:#171912
