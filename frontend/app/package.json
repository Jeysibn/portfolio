{
  "name": "jeysibn-portfolio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:ui": "playwright test",
    "perf:budget": "node scripts/check-performance.mjs",
    "validate:ci": "npm run typecheck && npm run lint && npm test -- --run && npm run build && npm run perf:budget && PLAYWRIGHT_SKIP_BUILD=1 npm run test:ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-icons": "^16.30.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.55.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  }
}
